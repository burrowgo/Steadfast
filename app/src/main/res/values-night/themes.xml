<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Steadfast" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Steadfast.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#12140E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Steadfast</item>
    </style>
</resources>
